{
  "name": "advanced_robotics_devcontainer_wsl_nvidia",
  "dockerComposeFile": [
    "../wsl/docker-compose.wsl.yml",
    "../wsl/docker-compose.wsl.nvidia.yml"
  ],
  "service": "advanced_robotics",
  "workspaceFolder": "/home/student/ros2_ws/",
  "remoteUser": "student",
  "containerUser": "student",
  "containerEnv": {
    "SHELL": "/bin/bash",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "redhat.vscode-xml",
        "Ranch-Hand-Robotics.rde-ros-2"
      ]
    }
  }
}
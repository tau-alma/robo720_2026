<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <xacro:arg name="arm_id" default="fr3" /> <!-- Name of this fr3 -->
  <xacro:arg name="end_effector" default="" />
  <xacro:arg name="camera" default="false" />
  <xacro:arg name="sim_ignition" default="false" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="effort_commands" default="false" />
  
  <!-- initial position for simulations (Ignition) -->
  <xacro:arg name="initial_positions_file"
    default="$(find franka_description)/config/initial_positions.yaml" />
  <!-- convert some arguments to properties to use substitution in function -->
  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)" />
  <xacro:property name="end_effector" default="$(arg end_effector)" />

  <link name="world">
  </link>
  <joint name="world_base" type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="base" />
  </joint>
  <!-- box shaped table as base -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.5 1" />
      </geometry>
      <material name="metal">
        <color rgba="0.768627450980392 0.749019607843137 0.729411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.5 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="10" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
        iyy="1e-3" iyz="0.0"
        izz="1e-3" />
    </inertial>
  </link>

  <!-- Include macros -->
  <!-- Franka arm -->
  <xacro:include filename="$(find franka_description)/urdf/fr3_arm.xacro" />
  <xacro:fr3_arm arm_id="$(arg arm_id)" sim_ignition="$(arg sim_ignition)" connected_to="base"
    xyz="0 0 1"
    safety_distance="0.03" />

  <!-- FR3 gripper -->
  <xacro:if value="${end_effector == 'gripper'}">
    <xacro:include filename="$(find franka_description)/urdf/hand.xacro" />
    <xacro:hand sim_ignition="$(arg sim_ignition)" ns="$(arg arm_id)" rpy="0 0 ${-pi/4}"
      connected_to="$(arg arm_id)_link8"
      safety_distance="0.03" />
  </xacro:if>

  <!-- Force torque sensor -->
  <xacro:if value="${end_effector == 'ft_sensor'}">
    <xacro:include filename="$(find franka_description)/urdf/ft_sensor.xacro" />
    <xacro:ft_sensor ns="$(arg arm_id)" connected_to="$(arg arm_id)_link8"
      safety_distance="0.03" />
  </xacro:if>

  <!-- Camera link -->
  <xacro:if value="$(arg camera)">
    <xacro:include filename="$(find franka_description)/urdf/camera.xacro" />
    <xacro:rgb_camera parent_link="$(arg arm_id)_link7" camera_link_name="$(arg arm_id)_camera_link"
      camera_optical_link_name="$(arg arm_id)_camera_link_optical" />
  </xacro:if>

  <!-- ROS2 control -->
  <xacro:include
    filename="$(find franka_description)/urdf/ros2_control/effort_fr3_arm.ros2_control.xacro" />
  <xacro:fr3_arm_ros2_control
    ns="$(arg arm_id)"
    sim_ignition="$(arg sim_ignition)"
    use_fake_hardware="$(arg use_fake_hardware)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    end_effector="${end_effector}" 
    effort_commands="$(arg effort_commands)" />

  <!-- Gazebo plugins -->
  <xacro:if value="$(arg sim_ignition)">
    <!-- Force torque sensor plugin -->
    <xacro:if value="${end_effector == 'ft_sensor'}">
      <gazebo reference=" TODO ">
        <sensor name="force_torque_sensor" type=" TODO ">
          <update_rate>100.0</update_rate>
          <always_on>true</always_on>
          <topic> TODO </topic>
          <visualize>true</visualize>
          <ignition_frame_id> TODO </ignition_frame_id>
          <TODO>
            <frame>child</frame>
            <measure_direction>parent_to_child</measure_direction>
          </TODO>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg camera)">
      <gazebo reference="fr3_camera_link_optical">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image</topic>
          <ignition_frame_id>fr3_camera_link_optical</ignition_frame_id>
          <!-- rotate the camera to point towards z-axis (desired optical axis) -->
          <pose>0 0 0 ${pi/2} -${pi/2} 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- ROS2 control plugin -->
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>